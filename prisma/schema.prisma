generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("CONTENT_ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamMember {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  rollNumber   String?
  branch       String?
  position     String
  category     String
  academicYear String?
  designation  String?
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  slug                String        @unique
  startDate           DateTime
  endDate             DateTime?
  shortOverview       String
  detailedDescription String
  coverImage          String?
  status              String        @default("UPCOMING")
  registrationStatus  String        @default("NOT_AVAILABLE")
  googleFormUrl       String?
  images              EventImage[]
  certificates        Certificate[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model EventImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  url       String
  order     Int      @default(0)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Magazine {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  month      String
  year       String
  coverImage String?
  pdfUrl     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WebsiteSettings {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clubName     String   @default("AlgoRhythm Club")
  description  String   @default("Technical Club of IT Department, GVPIHLR")
  whatsappUrl          String?
  instagramUrl         String?
  linkedinUrl          String?
  githubUrl            String?
  footerText           String   @default("© 2026 AlgoRhythm Club, GVPIHLR")
  algorhythmLogoFileId String?  @default("1MksFuGHsvPK1lKR2VpWwpDLBUFzVYRtA")
  gvpihlrLogoFileId    String?  @default("1eIjTCmN1tN9p7VAhwoIHm5Tv3kfBDTxl")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Certificate {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId          String   @db.ObjectId
  rollNumber       String?
  studentName      String?
  fileName         String
  storageKey       String   @unique
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}